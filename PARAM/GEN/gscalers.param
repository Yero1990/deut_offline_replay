; C. Yero | BCM calibrations done for CaFe using BCM Calibration run 16432 taken on Aug 23, 2022 (during pionLT running)
; BCM calibration run 16432 taken on Aug 23, 2022  
; Experimenters should be wary of the impact of the current threshold when taking production data near 5 muA.  
; DJ Mack: Note this version includes a small but highly significant saturation correction for BCM1,2 that turns on above 50 muA (reaching ~1% at 70 muA).

;gNumBCMs=6
;gBCM_Names =            "BCM1      BCM2      Unser      BCM4A      BCM4B      BCM4C"
;gBCM_Gain =              5689.33,   5538.61,  4011.2,   9385.86,   40194.2,  5108.78
;gBCM_Offset =            1941.07,   250015.,  244000., -161.822,  -5498.83,  145.428
;gBCM_SatOffset =         50.,       50.,    1000.,     1000.,     1000.,     1000. 
;gBCM_SatQuadratic =  0.00175,    0.002,      0.0,     0.0,     0.0,    0.0 
;gBCM_Current_threshold = 5.0
; index = 0 to gNumBCMs-1
;gBCM_Current_threshold_index = 3


;USING ONLY XEM2 RUN 20277 
;BCM Scan in SHMS 20277 taken on 01/29/2023
;Redone using original script with BCM ranges suggestions by D. Mack.
; 08-18-26 Optimized BCM calib 

gNumBCMs    = 6
gBCM_Names  = " BCM1      BCM2       Unser    BCM4A     BCM4B      BCM4C"
gBCM_Gain   =   5614.38,  5487.14,   4013.,   9467.40,  1.88199E4, 5207.68
gBCM_Offset =   2352.12,  2.5016E5,  4.234E5, -1381.83, 2.77382E5, -484.09


; The following two lines are to correct for ~1% saturation 
; in BCM1,2 between 50 and 70 muA. 
gBCM_SatOffset=   50.,   50.,  1000., 1000., 1000.,   1000. 
gBCM_SatQuadratic=  0.00175,  0.002,  0.0,  0.0,  0.0,  0.0 

gBCM_Current_threshold = 5.0
; index = 0 to gNumBCMs-1
gBCM_Current_threshold_index = 0

;gBCM_Names  = 	   " BCM1     BCM2   Unser    BCM4A     BCM4B      BCM4C"
;gBCM_Gain_err   =   18.08,   17.66,    -,    30.48,    60.55,     16.77
;gBCM_Offset_err =   657.85,  642.98,   -,    1109.30,  2100,      610.19